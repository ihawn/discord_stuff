# Copy to .env (never commit it). Everything except the first two has a default.
DISCORD_TOKEN=
TRANSCRIPT_CHANNEL_ID=
# Only watch these voice channels (comma-separated IDs). Empty = every voice channel in GUILD_ID.
WATCH_CHANNEL_IDS=
GUILD_ID=
LEAVE_GRACE_SECONDS=60
MIN_SESSION_SECONDS=20
MAX_SESSION_HOURS=6
MAX_UPLOAD_MB=10
RETENTION_DAYS=14
TIMEZONE=UTC
# Transcriber
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=en
WHISPER_THREADS=4
# Server only: where CI pushes the images, ghcr.io/<github-owner>/<repo>. Leave empty to build locally.
IMAGE_PREFIX=
